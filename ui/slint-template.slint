import "assets/fonts/Inter-Italic-VariableFont_opsz,wght.ttf";
import "assets/fonts/Inter-VariableFont_opsz,wght.ttf";
import { Button } from "std-widgets.slint";


global CounterState {
    in property <int> count;
}


global CounterIntents {
    callback increment();
    callback decrement();
    callback reset();
}


export component SlintTemplate inherits Window {
    title: "Slint template";
    default-font-family: "Inter";
    default-font-size: 14px;
    preferred-width: 400px;
    preferred-height: 400px;

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 20px;
        Text {
            text: "\{CounterState.count}";
            font-size: 64px;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: "-";
                clicked => { CounterIntents.decrement() }
            }

            Button {
                text: "Reset";
                clicked => { CounterIntents.reset() }
            }

            Button {
                text: "+";
                clicked => { CounterIntents.increment() }
            }
        }
    }
}

export { CounterState, CounterIntents }
